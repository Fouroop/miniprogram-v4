<view class="page">
  <view class="page-head">
    <view class="hello">你好，{{user.nickname || '同学'}}</view>
    <view class="hello-sub">今天有 <text class="red">{{stats.pending}} 道错题</text> 需要复习，坚持复盘，下次不再错。</view>
  </view>

  <!-- AI 语音辅导入口 -->
  <view class="call-hero" bindtap="goCall">
    <view class="call-hero-ic">
      <view class="phone-icon">AI</view>
    </view>
    <view class="call-hero-body">
      <view class="call-hero-title">语音问老师</view>
      <view class="call-hero-desc">按住说话 · AI 引导式思维</view>
    </view>
    <view class="call-hero-right">
      <view class="call-hero-min">{{voiceBal.minutes}} 分钟</view>
      <view class="call-hero-go">去对话 ></view>
    </view>
  </view>

  <!-- 统计卡片（点击跳转） -->
  <view class="stat-grid">
    <view class="stat-card red" data-key="pending" bindtap="statTap">
      <view class="stat-num">{{stats.pending}}</view>
      <view class="stat-lbl">待攻克 ›</view>
    </view>
    <view class="stat-card" data-key="mastered" bindtap="statTap">
      <view class="stat-num amber">{{stats.mastered}}</view>
      <view class="stat-lbl">已掌握 ›</view>
    </view>
    <view class="stat-card green" data-key="total" bindtap="statTap">
      <view class="stat-num">{{stats.total}}</view>
      <view class="stat-lbl">错题总数 ›</view>
    </view>
    <view class="stat-card blue" data-key="week" bindtap="statTap">
      <view class="stat-num">{{stats.week}}</view>
      <view class="stat-lbl">本周辅导 ›</view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="entry-grid">
    <view class="entry" bindtap="goScan">
      <view class="entry-ic red">
        <view class="entry-ic-text">拍</view>
      </view>
      <view class="entry-body">
        <view class="entry-name">拍照识别错题</view>
        <view class="entry-desc">拍一张卷子，AI 自动提取题目</view>
      </view>
    </view>
    <view class="entry" bindtap="goQuestions">
      <view class="entry-ic green">
        <view class="entry-ic-text">题</view>
      </view>
      <view class="entry-body">
        <view class="entry-name">题库</view>
        <view class="entry-desc">全年级 · 几何函数 · 预置题目</view>
      </view>
    </view>
    <view class="entry" bindtap="goMistakes">
      <view class="entry-ic blue">
        <view class="entry-ic-text">本</view>
      </view>
      <view class="entry-body">
        <view class="entry-name">错题本</view>
        <view class="entry-desc">按科目复习，逐个攻克</view>
      </view>
    </view>
  </view>

  <!-- 掌握不牢固的题 -->
  <view class="card" wx:if="{{weakList.length}}">
    <view class="section-title">
      掌握不牢固的题
      <text class="section-more" bindtap="goMistakes">查看全部 ›</text>
    </view>
    <view class="weak-item" wx:for="{{weakList}}" wx:key="id">
      <view class="weak-main" data-id="{{item.id}}" bindtap="openDetail">
        <view class="recent-top">
          <text class="badge badge-subject">{{item.subject}}</text>
          <text class="badge badge-status">{{item.status}}</text>
        </view>
        <view class="recent-stem">{{item.stem}}</view>
      </view>
      <view class="weak-ask" data-id="{{item.id}}" bindtap="askQuestion">问这道题</view>
    </view>
  </view>

  <!-- 最近错题 -->
  <view class="card" wx:if="{{recent.length}}">
    <view class="section-title">最近错题</view>
    <view class="recent-item" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="recent-top">
        <text class="badge badge-subject">{{item.subject}}</text>
        <text class="badge {{item.status === '已掌握' ? 'badge-status-ok' : (item.status === '复习中' ? 'badge-status-review' : 'badge-status')}}">{{item.status}}</text>
      </view>
      <view class="recent-stem">{{item.stem}}</view>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
