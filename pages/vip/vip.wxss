.page { padding: 30rpx; }
.pay-card {
  position: relative;
  background: #FFFDF8;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 28rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(66, 54, 30, 0.07);
  margin-bottom: 24rpx;
}
.pay-card.hot { border-color: #D64541; }
.hot-tag {
  position: absolute;
  top: -14rpx;
  right: 28rpx;
  background: #D64541;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 18rpx;
  border-radius: 12rpx;
}
.pc-name { font-size: 28rpx; font-weight: 700; }
.pc-price { font-size: 60rpx; font-weight: 700; margin: 16rpx 0 4rpx; }
.pc-unit { font-size: 26rpx; color: #6E675A; font-weight: 500; }
.pc-note { font-size: 23rpx; color: #6E675A; margin-bottom: 20rpx; }
.pc-feat { font-size: 24rpx; color: #6E675A; margin-bottom: 10rpx; }
.pc-btn { margin-top: 24rpx; }

.code-row { display: flex; gap: 16rpx; align-items: center; }
.code-input {
  flex: 1;
  padding: 18rpx 24rpx;
  border: 1.5rpx solid #CFC2A6;
  border-radius: 16rpx;
  background: #F6F0E4;
  font-size: 26rpx;
}
.pay-note {
  text-align: center;
  font-size: 22rpx;
  color: #A69C89;
  margin-top: 24rpx;
}
.bottom-space { height: 160rpx; }

/* 当前余量 */
.cur-balance {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #8B1E1A, #B23A35);
  border-radius: 28rpx;
  padding: 36rpx;
  color: #FFF8EC;
  margin-bottom: 28rpx;
}
.cb-num { font-size: 72rpx; font-weight: 800; line-height: 1; }
.cb-unit { font-size: 26rpx; font-weight: 600; margin-left: 10rpx; }
.cb-sub { font-size: 22rpx; opacity: .85; margin-top: 10rpx; }
.cb-sub.warn { color: #FFD9A0; font-weight: 700; }
.cb-tip { font-size: 22rpx; opacity: .75; max-width: 200rpx; text-align: right; line-height: 1.6; }

/* 申请记录 */
.apply-list { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.al-title { font-size: 26rpx; color: #666; margin-bottom: 12rpx; }
.al-item { display: flex; justify-content: space-between; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid #f2f3f5; font-size: 28rpx; }
.al-item:last-child { border-bottom: none; }
.al-name { color: #333; }
.al-status { color: #c98a2d; font-size: 24rpx; padding: 2rpx 14rpx; border-radius: 20rpx; background: #fdf1dc; }
.al-status.ok { color: #1a7f37; background: #e3f7ec; }
.al-status.no { color: #C0392B; background: #fde4e5; }
