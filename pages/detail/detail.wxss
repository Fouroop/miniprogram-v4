.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F6F0E4;
  box-sizing: border-box;
  padding: 24rpx 30rpx;
}

.loading, .empty { text-align: center; color: #A69C89; font-size: 24rpx; padding: 120rpx 0; }

.tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.tag { font-size: 20rpx; padding: 6rpx 16rpx; border-radius: 999rpx; }
.tag-subject { background: #F7E3E0; color: #D64541; }
.tag-grade { background: #EDE9F7; color: #7A6BC9; }
.tag-topic { background: #E5F0E7; color: #4C8A5C; }
.tag-diff { background: #EFE6D4; color: #A69C89; }
.tag-ok { background: #3B6EA5; color: #fff; }
.tag-review { background: #E5F0E7; color: #4C8A5C; }
.tag-weak { background: #F3E9D8; color: #C98A2D; }

.detail-img { width: 100%; border-radius: 18rpx; border: 1.5rpx solid #EEE4D0; margin-bottom: 20rpx; }

/* 内容滚动区：固定剩余高度，长题干滚动显示，按钮不受影响 */
.body {
  flex: 1;
  min-height: 0;
  height: 0;
  background: #FFFDF8;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}
.sec-label { font-size: 23rpx; font-weight: 700; color: #C98A2D; margin: 18rpx 0 8rpx; }
.sec-label:first-child { margin-top: 0; }
.sec-text { font-size: 27rpx; color: #2B2A26; line-height: 1.8; }
.sec-answer { color: #3B6EA5; font-weight: 700; }
.sec-analysis { color: #4A463E; }
.sec-reason { color: #D64541; }

/* 底部操作栏 */
.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
  flex-shrink: 0;
}
.d-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.d-btn.ghost { background: #EFE6D4; color: #6E675A; }
.d-btn.primary { background: #3B6EA5; color: #fff; }
.d-btn.revert { background: #FDE4E5; color: #C0392B; }
.d-btn.more {
  flex: 0 0 108rpx;
  background: #FFFDF8;
  border: 1.5rpx solid #E2D8C2;
  color: #A69C89;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

/* 编辑弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
}
.editor-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFDF8;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 99;
  transform: translateY(110%);
  transition: transform 0.25s ease;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
}
.editor-up { transform: translateY(0); }
.ep-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.ep-body { max-height: 55vh; }
.ep-row { margin-bottom: 22rpx; }
.ep-label { font-size: 24rpx; color: #A69C89; margin-bottom: 10rpx; }
.ep-input {
  width: 100%;
  box-sizing: border-box;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 16rpx;
  background: #fff;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  color: #2B2A26;
  min-height: 80rpx;
}
.ep-area { min-height: 120rpx; }
.ep-picker { display: flex; align-items: center; height: 80rpx; }
.ep-btns { display: flex; gap: 20rpx; margin-top: 26rpx; }
.ep-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}
.ep-cancel { background: #F1EBDE; color: #6E675A; }
.ep-save { background: #07C160; color: #fff; }
