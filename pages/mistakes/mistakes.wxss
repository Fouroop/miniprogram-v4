.page { padding: 30rpx; }
.m-card {
  background: #FFFDF8;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(66, 54, 30, 0.07);
  margin-bottom: 20rpx;
}
.mc-top { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.mc-stem {
  font-size: 27rpx;
  line-height: 1.75;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.mc-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 22rpx;
}
.mc-reason { color: #D64541; }
.mc-date { color: #A69C89; }
