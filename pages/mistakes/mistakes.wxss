.page { padding: 30rpx; }
.m-card {
  background: #FFFDF8;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(66, 54, 30, 0.07);
  margin-bottom: 20rpx;
}
.mc-top { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.mc-stem {
  font-size: 27rpx;
  line-height: 1.75;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.mc-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 22rpx;
}
.mc-more {
  position: absolute;
  top: 10rpx;
  right: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #A69C89;
  padding: 4rpx 14rpx;
  line-height: 1;
  z-index: 2;
}
.m-card { position: relative; }
.mc-reason { color: #D64541; }
.mc-date { color: #A69C89; }

/* 编辑弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
}
.editor-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFDF8;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 99;
  transform: translateY(110%);
  transition: transform 0.25s ease;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
}
.editor-up { transform: translateY(0); }
.ep-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}
.ep-body { max-height: 52vh; }
.ep-row { margin-bottom: 22rpx; }
.ep-label {
  font-size: 24rpx;
  color: #A69C89;
  margin-bottom: 10rpx;
}
.ep-input {
  width: 100%;
  box-sizing: border-box;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 16rpx;
  background: #fff;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  color: #2B2A26;
  min-height: 80rpx;
}
.ep-area { min-height: 120rpx; }
.ep-picker {
  display: flex;
  align-items: center;
  height: 80rpx;
}
.ep-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 26rpx;
}
.ep-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}
.ep-cancel {
  background: #F1EBDE;
  color: #6E675A;
}
.ep-save {
  background: #07C160;
  color: #fff;
}
