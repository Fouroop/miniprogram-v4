.page {
  padding: 28rpx 30rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #F6F0E4;
}

/* 头部 */
.head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.head-title { font-size: 40rpx; font-weight: 800; color: #2B2A26; }
.head-sub { font-size: 23rpx; color: #6E675A; margin-top: 6rpx; }
.head-note { font-size: 21rpx; color: #C98A2D; background: #F6ECD9; border-radius: 999rpx; padding: 8rpx 18rpx; }

/* 筛选 */
.tabs { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 16rpx; }
.tab {
  padding: 14rpx 38rpx;
  border-radius: 999rpx;
  background: #EFE6D4;
  color: #6E675A;
  font-size: 26rpx;
  font-weight: 700;
}
.tab.on { background: #3B6EA5; color: #fff; }

/* 列表 */
.q-item {
  display: flex;
  gap: 20rpx;
  background: #FFFDF8;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.q-img {
  width: 170rpx;
  height: 170rpx;
  border-radius: 16rpx;
  background: #FAF6EC;
  border: 1.5rpx solid #EEE4D0;
  flex-shrink: 0;
}
.q-main { flex: 1; min-width: 0; }
.q-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 12rpx; }
.tag { font-size: 19rpx; padding: 4rpx 14rpx; border-radius: 999rpx; }
.tag-subject { background: #F7E3E0; color: #D64541; }
.tag-topic { background: #E5F0E7; color: #4C8A5C; }
.tag-diff { background: #EFE6D4; color: #A69C89; }
.tag-diff.hard { background: #F7E3E0; color: #D64541; }
.tag-diff.easy { background: #E5F0E7; color: #4C8A5C; }
.q-stem {
  font-size: 26rpx;
  color: #2B2A26;
  line-height: 1.65;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.list-end { text-align: center; color: #A69C89; font-size: 22rpx; padding: 24rpx 0 8rpx; }
.empty { text-align: center; padding: 120rpx 0; color: #A69C89; }
.empty-ic { width: 110rpx; height: 110rpx; line-height: 110rpx; border-radius: 50%; background: #EFE6D4; margin: 0 auto 20rpx; font-size: 30rpx; font-weight: 700; }
.loading { text-align: center; color: #A69C89; font-size: 22rpx; padding: 20rpx; }

/* 详情弹层 */
.mask { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.45); z-index: 90; }
.detail {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFDF8;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 91;
  padding: 28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  max-height: 86vh;
  display: flex;
  flex-direction: column;
}
.detail-title { font-size: 32rpx; font-weight: 800; text-align: center; margin-bottom: 20rpx; }
.detail-img { width: 100%; border-radius: 18rpx; border: 1.5rpx solid #EEE4D0; margin-bottom: 20rpx; }
.detail-body { flex: 1; min-height: 0; }
.sec-label { font-size: 23rpx; font-weight: 700; color: #C98A2D; margin: 18rpx 0 8rpx; }
.sec-text { font-size: 27rpx; color: #2B2A26; line-height: 1.8; }
.sec-answer { color: #3B6EA5; font-weight: 700; }
.sec-analysis { color: #4A463E; }
.detail-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.d-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 700;
}
.d-btn.ghost { background: #EFE6D4; color: #6E675A; }
.d-btn.primary { background: #3B6EA5; color: #fff; }

/* 详情头部 + 更多按钮 */
.detail-head { display: flex; align-items: center; justify-content: space-between; }
.detail-title { font-size: 30rpx; font-weight: 700; }
.detail-more {
  font-size: 34rpx;
  font-weight: 700;
  color: #A69C89;
  padding: 4rpx 14rpx;
  line-height: 1;
}

/* 编辑题目弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 90;
}
.editor-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFFDF8;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 99;
  transform: translateY(110%);
  transition: transform 0.25s ease;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
}
.editor-up { transform: translateY(0); }
.ep-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.ep-body { max-height: 52vh; }
.ep-row { margin-bottom: 22rpx; }
.ep-label { font-size: 24rpx; color: #A69C89; margin-bottom: 10rpx; }
.ep-input {
  width: 100%;
  box-sizing: border-box;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 16rpx;
  background: #fff;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  color: #2B2A26;
  min-height: 80rpx;
}
.ep-area { min-height: 120rpx; }
.ep-picker { display: flex; align-items: center; height: 80rpx; }
.ep-btns { display: flex; gap: 20rpx; margin-top: 26rpx; }
.ep-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}
.ep-cancel { background: #F1EBDE; color: #6E675A; }
.ep-save { background: #07C160; color: #fff; }
