.login-wrap {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.login-card {
  width: 100%;
  background: #FFFDF8;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 36rpx;
  padding: 60rpx 50rpx;
  box-shadow: 0 20rpx 60rpx rgba(66, 54, 30, 0.12);
}
.login-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}
.brand-mark {
  margin-bottom: 20rpx;
}
.brand-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 26rpx;
  background: #FFFDF8;
  border: 4rpx solid #CFC2A6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.brand-check {
  color: #D64541;
  font-size: 52rpx;
  font-weight: 700;
}
.brand-name {
  font-size: 42rpx;
  font-weight: 700;
}
.brand-red { color: #D64541; }
.brand-slogan {
  font-size: 24rpx;
  color: #6E675A;
  margin-top: 8rpx;
}

/* 微信一键登录（仅微信登录） */
.wx-login {
  margin-top: 10rpx;
}
.btn-wx {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 30rpx 0;
  border-radius: 24rpx;
  font-size: 32rpx;
  background: #07C160;
  border-color: #07C160;
  color: #fff;
  font-weight: 700;
}
.btn-wx::after { border: none; }
.btn-wx[disabled] { background: #9AD8B3; color: #fff; }
.wx-ic {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 10rpx;
  background: #fff;
  color: #07C160;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.wx-note {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A69C89;
}

/* 用户协议同意 */
.agree-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 8rpx 4rpx;
}
.agree-box {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid #CFC2A6;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.agree-on {
  background: #D64541;
  border-color: #D64541;
}
.agree-check {
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}
.agree-text {
  font-size: 22rpx;
  color: #6E675A;
  line-height: 1.5;
}
.agree-link {
  color: #3B6EA5;
}
