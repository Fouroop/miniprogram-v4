.page { padding: 30rpx 30rpx 0; display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; }

/* 付费墙 */
.wall {
  text-align: center;
  padding: 90rpx 40rpx;
  background: #FFFDF8;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 28rpx;
}
.wall-lock {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #F6ECD9;
  color: #C98A2D;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
}
.wall-title { font-size: 34rpx; font-weight: 700; margin-bottom: 12rpx; }
.wall-desc { font-size: 25rpx; color: #6E675A; margin-bottom: 36rpx; }

/* 头部（统一） */
.chat-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #FFFDF8;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 28rpx 28rpx 0 0;
  padding: 20rpx 24rpx;
  flex-shrink: 0;
}
.chat-head-action {
  margin-left: auto;
  font-size: 24rpx;
  color: #A69C89;
  font-weight: 700;
  padding: 10rpx 22rpx;
  border: 1.5rpx solid #E2D8C2;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.chat-head-action.danger { color: #D64541; border-color: #EBC4C1; }
.ai-dot {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #F7E3E0;
  border: 1.5rpx solid #EBC4C1;
  color: #D64541;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}
.ai-dot.live { box-shadow: 0 0 0 6rpx rgba(214, 69, 65, 0.18); animation: pulseDot 1.4s infinite; }
@keyframes pulseDot { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }
.chat-head-t { flex: 1; min-width: 0; }
.chat-title {
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.chat-sub { font-size: 21rpx; color: #6E675A; margin-top: 4rpx; }

.stem-strip { background: #EFE6D4; padding: 14rpx 28rpx; border-bottom: 1.5rpx solid #E2D8C2; }
.stem-head { font-size: 22rpx; font-weight: 700; color: #6E675A; display: flex; }
.stem-toggle { margin-left: auto; color: #A69C89; font-weight: 500; }
.stem-body {
  font-size: 26rpx;
  line-height: 1.8;
  padding-top: 16rpx;
  border-top: 2rpx dashed #CFC2A6;
  margin-top: 12rpx;
}

.chat-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 28rpx;
  background: #FFFDF8;
  border-left: 1.5rpx solid #E2D8C2;
  border-right: 1.5rpx solid #E2D8C2;
}
.msg { display: flex; gap: 16rpx; margin-bottom: 24rpx; max-width: 88%; }
.msg.ai { align-self: flex-start; }
.msg.user { align-self: flex-end; flex-direction: row-reverse; }
.mini-av {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
}
.msg.ai .mini-av { background: #D64541; }
.msg.user .mini-av { background: #E3EDF7; color: #3B6EA5; }
.bubble {
  padding: 20rpx 26rpx;
  border-radius: 24rpx;
  font-size: 27rpx;
  line-height: 1.8;
  word-break: break-all;
}
.msg.ai .bubble { background: #EFE6D4; border: 1.5rpx solid #E2D8C2; border-top-left-radius: 6rpx; }
.msg.user .bubble { background: #3B6EA5; color: #fff; border-top-right-radius: 6rpx; }
.bubble.voice { background: #E9F0FA; color: #2B2A26; border: 1.5rpx solid #D6E4F2; }
.voice-tag {
  display: inline-block;
  font-size: 19rpx;
  font-weight: 700;
  color: #3B6EA5;
  background: #DCE9F6;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-right: 10rpx;
}
.stream-caret { color: #A69C89; }
.bubble.typing { display: flex; gap: 10rpx; align-items: center; }
.dot-i { width: 12rpx; height: 12rpx; border-radius: 50%; background: #A69C89; }

/* 底部输入栏（微信聊天式：语音/键盘切换） */
.input-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 20rpx;
  background: #FFFDF8;
  border: 1.5rpx solid #E2D8C2;
  border-top: none;
  border-radius: 0 0 28rpx 28rpx;
  flex-shrink: 0;
}
.input-mode-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F6F0E4;
  border: 1.5rpx solid #E2D8C2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.input-mode-btn.on { background: #E3EDF7; border-color: #BBD2E8; }
.im-icon { font-size: 34rpx; line-height: 1; }
.input-box {
  flex: 1;
  min-width: 0;
  padding: 20rpx 26rpx;
  border: 1.5rpx solid #CFC2A6;
  border-radius: 999rpx;
  background: #F6F0E4;
  font-size: 28rpx;
  box-sizing: border-box;
}
.input-ph { color: #A69C89; font-size: 27rpx; }
.send-btn {
  flex-shrink: 0;
  padding: 20rpx 34rpx;
  border-radius: 999rpx;
  background: #3B6EA5;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  border: none;
  line-height: 1;
}
.send-btn::after { border: none; }
.ptt-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  background: #4C8A5C;
  box-shadow: 0 6rpx 24rpx rgba(76, 138, 92, 0.35);
}
.ptt-btn.paused {
  background: #D64541;
  box-shadow: 0 6rpx 24rpx rgba(214, 69, 65, 0.4);
  transform: scale(1.02);
}
.ptt-btn.start { background: #3B6EA5; box-shadow: 0 6rpx 24rpx rgba(59, 110, 165, 0.35); }
.ptt-btn:active { opacity: 0.85; }

/* 通话后掌握标记面板 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(30, 24, 15, 0.5);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}
.mastery-panel {
  width: 100%;
  background: #FFFDF8;
  border-radius: 36rpx 36rpx 0 0;
  padding: 40rpx 32rpx 50rpx;
  box-sizing: border-box;
}
.mastery-title { font-size: 34rpx; font-weight: 800; text-align: center; margin-bottom: 16rpx; }
.mastery-stem {
  font-size: 24rpx;
  color: #6E675A;
  background: #F6F0E4;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 28rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.mastery-opts { display: flex; gap: 18rpx; margin-bottom: 28rpx; }
.m-opt {
  flex: 1;
  border: 2rpx solid #E2D8C2;
  border-radius: 24rpx;
  padding: 26rpx 12rpx;
  text-align: center;
}
.m-opt.sel { border-color: #D64541; background: #FDF0EE; }
.m-opt.sel.weak { border-color: #C0392B; }
.m-opt.sel.reviewing { border-color: #C98A2D; background: #FBF3E3; }
.m-opt.sel.mastered { border-color: #4C8A5C; background: #EFF6F0; }
.m-opt-name { font-size: 27rpx; font-weight: 700; }
.m-opt-desc { font-size: 20rpx; color: #A69C89; margin-top: 6rpx; }
.mastery-tag-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #F6F0E4;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 32rpx;
}
.mt-label { font-size: 26rpx; font-weight: 700; color: #6E675A; flex-shrink: 0; }
.mt-input { flex: 1; font-size: 28rpx; }
.mastery-actions { display: flex; gap: 20rpx; }
.mastery-actions .btn { flex: 1; }
