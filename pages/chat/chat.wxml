<view class="page" bindtouchstart="onPageTouch">
  <!-- 文字对话免费开放；语音提问按语音包计费（首次接通时校验） -->

  <!-- 头部：AI 信息 + 通话状态/操作 -->
  <view class="chat-head">
    <view class="ai-dot {{callOn ? 'live' : ''}}">AI</view>
    <view class="chat-head-t">
      <view class="chat-title">AI 思维引导导师 · {{topic}}</view>
      <view class="chat-sub">{{headStatusText}}</view>
    </view>
    <view class="chat-head-action {{callOn ? 'danger' : ''}}" bindtap="onHeadAction">
      {{callOn ? '挂断' : '清空'}}
    </view>
  </view>

  <!-- 回声诊断面板（开发者调试） -->
  <view class="voice-diag" wx:if="{{debugVoice}}">
    <view class="diag-row" wx:for="{{voiceDiag}}" wx:key="*this">{{item}}</view>
  </view>

  <!-- 题干可折叠 -->
  <view class="stem-strip" wx:if="{{mistake}}" bindtap="toggleStem">
    <view class="stem-head">题干原文 <text class="stem-toggle">{{stemOpen ? '[ 收起 ]' : '[ 展开 ]'}}</text></view>
    <view class="stem-body" wx:if="{{stemOpen}}">{{mistake.stem}}</view>
  </view>

  <!-- 聊天记录（文字 + 语音统一） -->
  <scroll-view class="chat-body" scroll-y scroll-into-view="{{scrollIntoViewId}}" scroll-with-animation enable-flex>
    <view class="msg {{item.role === 'ai' ? 'ai' : 'user'}}" wx:for="{{messages}}" wx:key="index">
      <view class="mini-av">{{item.role === 'ai' ? 'AI' : '我'}}</view>
      <view class="bubble {{item.role === 'user' && item.voice ? 'voice' : ''}}" bindlongpress="onMsgLongPress" data-idx="{{index}}">
        <text class="voice-tag" wx:if="{{item.role === 'user' && item.voice}}">语音</text>
        {{item.text}}<text class="stream-caret" wx:if="{{item.stream}}">…</text>
      </view>
    </view>
    <view class="msg ai" wx:if="{{typing}}">
      <view class="mini-av">AI</view>
      <view class="bubble typing"><text class="dot-i"></text><text class="dot-i"></text><text class="dot-i"></text></view>
    </view>
    <!-- 滚动锚点：始终跟随到最新内容 -->
    <view id="msg-end" style="height:2rpx"></view>
  </scroll-view>

  <!-- 底部输入栏：微信聊天式（语音 / 键盘切换） -->
  <view class="input-bar">
    <view class="diag-toggle {{debugVoice ? 'on' : ''}}" bindtap="toggleVoiceDebug">诊</view>
    <view class="input-mode-btn {{inputMode === 'voice' ? 'on' : ''}}" bindtap="toggleInputMode">
      <text class="im-icon">{{inputMode === 'text' ? '🎤' : '⌨️'}}</text>
    </view>
    <block wx:if="{{inputMode === 'text'}}">
      <input class="input-box" value="{{inputText}}" bindinput="onInput" confirm-type="send" bindconfirm="sendText" placeholder="输入消息…" placeholder-class="input-ph" />
      <button class="send-btn" bindtap="sendText">发送</button>
    </block>
    <block wx:else>
      <view wx:if="{{!callOn}}" class="ptt-btn start" bindtap="startCall">开始语音聊天</view>
      <!-- 全双工免按：AI 说话中显示状态（可直接打断）；平时直接说话即可 -->
      <view wx:elif="{{aiSpeaking}}" class="ptt-btn waiting">AI 正在说话…（可直接打断）</view>
      <view wx:else class="ptt-btn live">通话中 · 直接说话</view>
    </block>
  </view>

  <!-- 通话后标记知识点掌握情况 -->
  <view class="mask" wx:if="{{showMastery}}" bindtap="closeMastery">
    <view class="mastery-panel" catchtap="noop">
      <view class="mastery-title">这次辅导后，掌握得怎么样？</view>
      <view class="mastery-stem" wx:if="{{mistake}}">{{mistake.stem}}</view>
      <view class="mastery-opts">
        <view class="m-opt {{masterySel === 'weak' ? 'sel weak' : ''}}" data-v="weak" bindtap="selMastery">
          <view class="m-opt-name">还没弄懂</view>
          <view class="m-opt-desc">明天再问一次</view>
        </view>
        <view class="m-opt {{masterySel === 'reviewing' ? 'sel reviewing' : ''}}" data-v="reviewing" bindtap="selMastery">
          <view class="m-opt-name">有点会了</view>
          <view class="m-opt-desc">4 天后复习</view>
        </view>
        <view class="m-opt {{masterySel === 'mastered' ? 'sel mastered' : ''}}" data-v="mastered" bindtap="selMastery">
          <view class="m-opt-name">完全掌握</view>
          <view class="m-opt-desc">15 天后巩固</view>
        </view>
      </view>
      <view class="mastery-tag-row">
        <text class="mt-label">知识点</text>
        <input class="mt-input" value="{{masteryTag}}" bindinput="onTagInput" placeholder="如：一元二次方程" />
      </view>
      <view class="mastery-actions">
        <button class="btn btn-ghost btn-sm" bindtap="closeMastery">跳过</button>
        <button class="btn btn-primary btn-sm" bindtap="confirmMastery">保存标记</button>
      </view>
    </view>
  </view>
</view>
